generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TeamMember {
  id           String   @id @default(cuid())
  name         String   @unique
  /// Soft-delete: inactive members stay linked to their tasks but can't be selected for new work.
  active       Boolean  @default(true)
  /// Per-member task list sort: newest | priority | carried | status
  sortBy       String   @default("newest")
  sortReversed Boolean  @default(false)
  createdAt    DateTime @default(now())
  tasks        Task[]
}

/// status: active | complete | obsolete
/// priority: high | medium | low
/// weekStart: ISO date (YYYY-MM-DD) for the Monday of that week
model Task {
  id         String     @id @default(cuid())
  title      String
  notes      String     @default("")
  status     String     @default("active")
  priority   String     @default("medium")
  weekStart  String
  rolledFrom String?
  memberId   String
  member     TeamMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([weekStart])
  @@index([memberId, weekStart])
}

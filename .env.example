DATABASE_URL="file:./dev.db"
SITE_PASSWORD="changeme"
AUTH_SECRET="replace-with-a-long-random-string"
APP_TIMEZONE="America/Los_Angeles"

# Google Doc archive + JSON backup (optional locally; REQUIRED for durable data
# when deploying without persistent storage — see google-apps-script/README.md).
# The app pushes a full snapshot on every change and restores from it on startup.
#
# IMPORTANT: Leave these EMPTY in local .env unless you are testing backup in
# isolation. With production credentials, local dev used to overwrite the live
# backup. Push/restore are now disabled unless BACKUP_ENV=production and
# BACKUP_PUSH_ENABLED / BACKUP_RESTORE_ENABLED are set.
GOOGLE_APPS_SCRIPT_URL=""
GOOGLE_SYNC_SECRET=""
# BACKUP_ENV="development"
# BACKUP_PUSH_ENABLED="false"
# BACKUP_RESTORE_ENABLED="false"

# Optional: override where the "restore succeeded" health marker is written.
# BACKUP_MARKER_PATH="/tmp/task-tracker-backup-ok"
